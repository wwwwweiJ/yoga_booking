**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*

# Uploaded files (instructor photos, etc.) — local storage backend
uploads/

# Node dependencies and the built SPA — both are reproduced from source by the
# Docker build (and by `pnpm install` / `pnpm build`), so they never belong in
# git. node_modules is ~70 MB; keep it out of the push.
node_modules/
frontend/dist/